{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proggaa",
  "version": "../../package.json",
  "identifier": "com.prooggaa.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Proggaa",
    "copyright": "Proggaa",
    "category": "Education",
    "shortDescription": "Proggaa - learn, practise and chat with your classmates",
    "longDescription": "The Proggaa learning platform (prooggaa.com) as a Windows app, with automatic updates.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyNzkzOEVDOUEzNDc0N0EKUldSNmREU2E3RGg1QXJVaHUxQW10Wk43eU1JemhjdWFxcDBmZmR4M2VTcGcyNVpDQ0h2cm52ZkYK",
      "endpoints": ["https://github.com/rahmannaiku-ux/proggaa-apps/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
